"""rpc-server simulado: escucha y hace eco de lo que reciba (prueba el camino túnel→proxy→rpc).

Imita también la parte de dispositivos del real:
- MOCK_DEVICES="Vulkan0|AMD Radeon RX 7600 XT|16368|15800;Vulkan1|…" (nombre|descripción|MiB|MiB libres).
  Sin aceleradores expone un único dispositivo CPU.
- `-d <nombre desconocido>` lista los dispositivos y termina con error (lo usa el agente para detectarlos).
- Como el real, NO admite --version (argumento desconocido: imprime el uso y sale con 0); -h/--help imprime el uso.
  La build se deduce del llama-server de la misma carpeta. MOCK_ARGS_FILE: guarda sus argumentos.
"""
import json
import os
import socket
import sys
import threading

HERE = os.path.dirname(os.path.abspath(__file__))
KNOWN = {"-d", "--device", "-H", "--host", "-p", "--port", "-t", "--threads", "-c", "--cache"}
WITH_VALUE = {"-d", "--device", "-H", "--host", "-p", "--port", "-t", "--threads"}
_i = 1
while _i < len(sys.argv):
    _arg = sys.argv[_i]
    if _arg in ("-h", "--help") or _arg not in KNOWN:
        if _arg not in ("-h", "--help"):
            print(f"error: unknown argument: {_arg}", file=sys.stderr)
        print(f"Usage: {sys.argv[0]} [options]", file=sys.stderr)
        sys.exit(0)
    _i += 2 if _arg in WITH_VALUE else 1

devs = []
for item in filter(None, os.environ.get("MOCK_DEVICES", "").split(";")):
    name, desc, total, free = item.split("|")
    devs.append((name, desc, int(total), int(free)))
if not devs:
    devs = [("CPU", "Mock CPU", 32768, 16000)]

a = sys.argv[1:]
if "-d" in a:
    wanted = a[a.index("-d") + 1].split(",")
    if any(w not in [d[0] for d in devs] for w in wanted):
        print(f"error: unknown device: {a[a.index('-d') + 1]}", file=sys.stderr)
        print("available devices:", file=sys.stderr)
        for name, desc, total, free in devs:
            print(f"  {name}: {desc} ({total} MiB, {free} MiB free)", file=sys.stderr)
        sys.exit(1)
if os.environ.get("MOCK_ARGS_FILE"):
    with open(os.environ["MOCK_ARGS_FILE"], "w") as f:
        json.dump(a, f)
host = a[a.index("-H") + 1] if "-H" in a else "127.0.0.1"
port = int(a[a.index("-p") + 1])
srv = socket.socket()
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind((host, port))
srv.listen(8)
print(f"mock rpc-server en {host}:{port}", flush=True)


def echo(c):
    try:
        while True:
            d = c.recv(65536)
            if not d:
                break
            c.sendall(d)
    except OSError:
        pass
    c.close()


while True:
    c, _ = srv.accept()
    threading.Thread(target=echo, args=(c,), daemon=True).start()
